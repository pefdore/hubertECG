<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🫀 hubertECG — 100 % local, aucune donnée ne quitte l'appareil"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0D3B66"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Patient"
            style="@style/TextAppearance.Material3.TitleMedium" />

        <EditText
            android:id="@+id/ageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Âge"
            android:inputType="number" />

        <EditText
            android:id="@+id/sexInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Sexe (H/F)" />

        <EditText
            android:id="@+id/antecedentsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Antécédents" />

        <EditText
            android:id="@+id/symptomesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Symptômes actuels" />

        <EditText
            android:id="@+id/medicamentsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Traitements en cours" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. ECG"
            android:layout_marginTop="16dp"
            style="@style/TextAppearance.Material3.TitleMedium" />

        <Button
            android:id="@+id/photoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Prendre une photo du tracé" />

        <ImageView
            android:id="@+id/photoPreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/fsInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Fréquence (Hz)"
                android:inputType="number"
                android:text="500" />

            <Button
                android:id="@+id/csvButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📄 CSV 12 dérivations" />
        </LinearLayout>

        <TextView
            android:id="@+id/csvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/ecgModelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🧬 HuBERT-ECG : analyser le signal (164 pathologies)" />

        <TextView
            android:id="@+id/ecgResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/mesuresInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mesures : FC, PR, QRS, QT/QTc, ST, observations…"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/analyzeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="⚡ Rapport clinique (LLM local)" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/reportText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Aide à la décision par IA. Ne remplace ni le jugement clinique ni l'avis d'un cardiologue. En cas de doute : urgences."
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
